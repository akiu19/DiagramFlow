<Window x:Class="DiagramFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiagramFlow"
        xmlns:vm="clr-namespace:DiagramFlow.ViewModels"
        mc:Ignorable="d"
        Title="Diagram Editor" Height="600" Width="800">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Content="Save" />
                <Button Content="Open" />
                <Separator />
                <Button Content="Reset Zoom"/>
                <!-- Drag source for new nodes goes here -->
                <Label Content="Drag Node: " VerticalAlignment="Center"/>
                <Rectangle Width="30" Height="20" Fill="LightBlue" Stroke="Black" />
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content -->
        <ScrollViewer x:Name="MainScrollViewer" 
                      Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="True">
            <!-- Using LayoutTransform on the content of ScrollViewer -->
            <ItemsControl ItemsSource="{Binding Nodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="10000" Height="10000" Background="White"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X.Value}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y.Value}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Node Template -->
                        <Border Background="{Binding Background.Value}" 
                                Width="{Binding Width.Value}" 
                                Height="{Binding Height.Value}"
                                BorderBrush="Black" BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock Text="{Binding Text.Value}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
                <ItemsControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ZoomScale.Value}" 
                                    ScaleY="{Binding ZoomScale.Value}"/>
                </ItemsControl.LayoutTransform>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status Bar / Zoom Slider -->
        <Grid Grid.Row="2" Background="LightGray">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <TextBlock Text="Zoom: " VerticalAlignment="Center"/>
                <Slider Minimum="0.1" Maximum="4.0" Width="200"
                        Value="{Binding ZoomScale.Value}"/>
                <TextBlock Text="{Binding ZoomScale.Value, StringFormat=P0}" VerticalAlignment="Center" Margin="5,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
